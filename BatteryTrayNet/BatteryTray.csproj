<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BatteryTray</AssemblyName>
    <RootNamespace>BatteryTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 版本号：本地开发用默认值，CI 通过 -p:Version=... 覆盖（见 .github/workflows/release.yml） -->
    <Version>1.0.0</Version>
    <Product>Lenovo M6X Battery Tray</Product>
    <Description>在 Windows 11 任务栏显示联想 Legion M6X / M6X Pro 鼠标电量</Description>
    <Company>MagicCube1845</Company>
    <Copyright>Copyright © 2026 MagicCube1845</Copyright>
    <RepositoryUrl>https://github.com/MagicCube1845/Lenovo_m6x_battery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    目标框架已升级到 net10.0-windows（本机 SDK 10.0.404 / WindowsDesktop 10.0.15）。

    RollForward 保留 Major：
      · 这台机器同时装着 10.0.10 和 10.0.15，默认策略会在同一大版本内自动挑最高的补丁，够用；
      · 但万一以后 10.x 被卸载、只留更高版本（11.x），Major 能让程序继续跑，
        而不是直接报 "You must install or update .NET"。
  -->
  <PropertyGroup>
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
